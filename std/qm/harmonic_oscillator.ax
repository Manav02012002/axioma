// Abstract harmonic oscillator for a single mode `ho`.
let a_op = annihilation(ho)
let adag_op = creation(ho)
let n_op = number_operator(ho)
let h_op = hamiltonian_ho(ho, hbar, omega)

let vac = vacuum(ho)
let one = apply_operator(adag_op, vac)
let two = apply_operator(adag_op, one)
let lowered_two = apply_operator(a_op, two)
let number_on_two = apply_operator(n_op, two)
let energy_on_one = apply_operator(h_op, one)
let normal_reordered = normal_order(annihilation(ho) * creation(ho))
let h_toy = [[1, 0], [0, 2]]
let rho_toy = [[1/2, 0], [0, 1/2]]
let jumps = []
let rho_dot = lindblad_rhs(h_toy, rho_toy, jumps)
let rho_euler = lindblad_euler_step(h_toy, rho_toy, jumps, 1/10)
let rho_rk4 = lindblad_rk4_step(h_toy, rho_toy, jumps, 1/10)

[a_op, adag_op, n_op, h_op, vac, one, two, lowered_two, number_on_two, energy_on_one, normal_reordered, rho_dot, rho_euler, rho_rk4]
