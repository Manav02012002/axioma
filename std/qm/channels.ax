// Finite-dimensional Kraus channels
depolarizing_channel(p)
let I = identity_channel(2)
let dep = depolarizing_channel(p)
let deph = dephasing_channel(p)
let amp = amplitude_damping_channel(gamma)
let bit = bit_flip_channel(p)
let phase = phase_flip_channel(p)
let bit_phase = bit_phase_flip_channel(p)
is_trace_preserving(dep)
is_trace_preserving(deph)
is_trace_preserving(amp)
is_trace_preserving(bit)
is_trace_preserving(phase)
is_trace_preserving(bit_phase)
compose_channels(I, I)
choi_distance(I, I)
trace_preserving_residual(I)
is_trace_preserving(I)
unital_residual(I)
is_unital(I)
let diagonal_channel = [[[1, 0], [0, 2]]]
choi_distance(I, diagonal_channel)
let amplitude_damping_like = [[[1, 0], [0, sqrt(1 - g)]], [[0, sqrt(g)], [0, 0]]]
trace_preserving_residual(amplitude_damping_like)
is_trace_preserving(amplitude_damping_like)
unital_residual(amplitude_damping_like)
is_unital(amplitude_damping_like)
tensor_product_channel(identity_channel(2), identity_channel(2));
