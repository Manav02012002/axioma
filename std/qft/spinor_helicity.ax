// Spinor-helicity amplitudes and shifts.
angle(1, 2)
square(1, 2)
mandelstam(1, 2)
angle_square_chain(1, [2], 3)
expand_chain(angle_square_chain(1, [2], 3))
contract_adjacent(angle(1, 2) * square(2, 3))
mandelstam_multi([1, 2, 3])
expand_mandelstam(mandelstam_multi([1, 2, 3]))
collect_mandelstam(angle(1, 2) * square(2, 1))
parke_taylor(4, 0, 2)
three_point_mhv(0, 1, 2)
spinor_simplify(angle(1, 2) * angle(2, 1), 2)
bcfw_shift(angle(1, 2), 1, 2, z)
