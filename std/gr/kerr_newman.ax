// Kerr-Newman metric (charged rotating black hole)
// Parameters: M (mass), a (spin parameter), Q (charge)
// Boyer-Lindquist coordinates: [t, r, theta, phi]
// This module now exposes the full off-diagonal metric as a symbolic matrix.
// Downstream curvature computations are possible, but expensive.
// For standard use we define the metric and coordinates without forcing the full connection.
let Sigma = r^2 + a^2 * cos(theta)^2
let Delta = r^2 - 2*M*r + a^2 + Q^2
let g = metric([[-(1 - (2*M*r - Q^2) / Sigma), 0, 0, -(2*M*r - Q^2) * a * sin(theta)^2 / Sigma], [0, Sigma / Delta, 0, 0], [0, 0, Sigma, 0], [-(2*M*r - Q^2) * a * sin(theta)^2 / Sigma, 0, 0, (r^2 + a^2 + (2*M*r - Q^2) * a^2 * sin(theta)^2 / Sigma) * sin(theta)^2]])
let coords = [t, r, theta, phi]
g
